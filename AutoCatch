--// UNIQUE HAIR VALUES FROM THE ORIGINAL TRACKER
local UniqueHairValues = {
    amethyst=true, blessed=true, clearquartz=true, clearseaglass=true, cowprint=true,
    crackedlavafade=true, deepspace=true, diamond=true, dustyfade=true, emerald=true,
    flowery=true, glacierblue=true, glaciergreen=true, glacierpink=true, iceyblack=true,
    iceyblue=true, iceygreen=true, iceypink=true, iceywhite=true, jaguarspots=true,
    leafy=true, leathery=true, limestone=true, moonstone=true, mossy=true, neonblue=true,
    neonpurple=true, obsidian=true, pastelstreaks=true, pearly=true, pearlyblue=true,
    pearlygreen=true, pearlypink=true, pearlypurple=true, pearlywhite=true,
    pinkcowprint=true, prismatic=true, royalstreaks=true, ruby=true, sandstone=true,
    sandy=true, sapphire=true, snowyglacierfade=true, sunrisestreaks=true, tigerstripes=true,
    topaz=true, volcanicblack=true, volcanicorange=true, winterstreaks=true, zebra=true
}

local function normalizeValue(v)
    return tostring(v or ""):lower():gsub("%s+", "")
end

local function checkUniqueHair(horse)
    local data = horse:GetAttribute("Data")
    if type(data) == "string" then
        local ok, decoded = pcall(function()
            return game:GetService("HttpService"):JSONDecode(data)
        end)
        if ok then data = decoded end
    end

    if type(data) ~= "table" then
        return false, "X"
    end

    local variants = data.variants
    if type(variants) ~= "table" then
        return false, "X"
    end

    local mane = normalizeValue(variants.maneColour)
    local tail = normalizeValue(variants.tailColour)
    if UniqueHairValues[mane] or UniqueHairValues[tail] then
        return true, "✓"
    end
    return false, "X"
end

local function GetHorseInfo(rawName)
    local name = tostring(rawName or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local lower = name:lower()

    for breed, info in pairs(RarityData) do
        if lower == breed:lower() then
            return breed, info.Rarity
        end
    end

    for breed, info in pairs(RarityData) do
        local b = breed:lower()
        if lower:find(b, 1, true) or b:find(lower, 1, true) then
            return breed, info.Rarity
        end
    end

    return name, "Low"
end

local function getHorsePivot(horse)
    if horse:IsA("Model") then
        local ok, pivot = pcall(function() return horse:GetPivot() end)
        if ok then return pivot end
    elseif horse:IsA("BasePart") then
        return horse.CFrame
    end
end

local function getHorseBreed(horse)
    local displayName = horse.Name
    pcall(function()
        local overheadPart = horse:FindFirstChild("OverheadPart")
        local overhead = overheadPart and overheadPart:FindFirstChild("Overhead")
        local label = overhead and overhead:FindFirstChild("BreedLabel")
        if label and label:IsA("TextLabel") and label.Text ~= "" then
            displayName = label.Text
        end
    end)
    return GetHorseInfo(displayName)
end

local function isHorse(node)
    if not node or not node.Parent then return false end
    local tagged = CollectionService:HasTag(node, "Animal")
    local behaviour = node:GetAttribute("behaviour")
    return tagged or behaviour == "WanderingAnimal"
end

local function isOwned(node)
    for attrKey, attrVal in pairs(node:GetAttributes()) do
        if attrKey:lower() == "owner" and attrVal ~= nil and tostring(attrVal) ~= "" then
            return true
        end
    end
    return false
end

local function isInShop(node)
    local current = node
    while current and current ~= Workspace do
        local n = current.Name:lower()
        if n:find("shop", 1, true) or n:find("stable", 1, true) then
            return true
        end
        current = current.Parent
    end
    return false
end

--// BACKGROUND SCANNER
local function ScanHorses()
    local now = tick()
    if now - LastScan < SCAN_INTERVAL and #ScanCache > 0 then
        return ScanCache
    end

    local results = {}
    local islands = Workspace:FindFirstChild("Islands")
    if not islands then
        ScanCache = results
        LastScan = now
        return results
    end

    local function scanContainer(container, islandName)
        for _, node in ipairs(container:GetChildren()) do
            if node:IsA("Folder") or (node:IsA("Model") and not CollectionService:HasTag(node, "Animal")) then
                scanContainer(node, islandName)
            elseif isHorse(node) and not isOwned(node) and not isInShop(node) then
                local pivot = getHorsePivot(node)
                if pivot then
                    local breed, rarity = getHorseBreed(node)
                    local unique = checkUniqueHair(node)
                    table.insert(results, {
                        Model=node,
                        Island=islandName,
                        Name=breed,
                        Rarity=rarity,
                        Unique=unique,
                        Position=pivot.Position,
                        Pivot=pivot,
                        UID=node:GetDebugId() or (node.Name .. "_" .. math.floor(pivot.Position.X) .. "_" .. math.floor(pivot.Position.Z))
                    })
                end
            end
        end
    end

    for _, island in ipairs(islands:GetChildren()) do
        if island:IsA("Folder") or island:IsA("Model") then
            scanContainer(island, island.Name)
        end
    end

    ScanCache = results
    LastScan = now
    return results
end

local function invalidate()
    ScanCache = {}
    LastScan = 0
end

local islandsFolder = Workspace:FindFirstChild("Islands")
if islandsFolder then
    islandsFolder.DescendantAdded:Connect(invalidate)
    islandsFolder.DescendantRemoving:Connect(invalidate)
end

Workspace.ChildAdded:Connect(function(child)
    if child.Name == "Islands" then
        child.DescendantAdded:Connect(invalidate)
        child.DescendantRemoving:Connect(invalidate)
        invalidate()
    end
end)

--// CURRENT ISLAND
local function GetCurrentPlayerIsland()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local islands = Workspace:FindFirstChild("Islands")
    if not root or not islands then return nil end

    local closestName, closestDistance = nil, math.huge
    for _, island in ipairs(islands:GetChildren()) do
        if island:IsA("Folder") or island:IsA("Model") then
            local pivot
            if island:IsA("Model") then
                pcall(function() pivot = island:GetPivot() end)
            end
            pivot = pivot or (island:FindFirstChildWhichIsA("BasePart", true) and island:FindFirstChildWhichIsA("BasePart", true).CFrame)
            if pivot then
                local d = (root.Position - pivot.Position).Magnitude
                if d < closestDistance then
                    closestDistance = d
                    closestName = island.Name
                end
            end
        end
    end
    return closestName
end

--// LASSO INPUT WITHOUT REMOTES
--// Catching uses simulated primary input (mouse/tap) at the center of the screen.
--// If input simulation is unavailable, it falls back to normal Tool:Activate().
local function FindLassoTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local wanted = {"lasso", "wooden lasso", "tin lasso", "cooper lasso", "bronze lasso", "iron lasso", "silver lasso", "clear quartz lasso", "gold lasso", "ruby lasso", "ice lasso", "diamond lasso", "obsidian lasso", "moonstone lasso", "topaz lasso", "emerald lasso", "amethyst lasso"}

    local function check(container)
        if not container then return nil end
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") then
                local n = obj.Name:lower()
                for _, wantedName in ipairs(wanted) do
                    if n == wantedName or n:find("lasso", 1, true) then
                        return obj
                    end
                end
            end
        end
    end

    return check(char) or check(backpack)
end

local function ActivateLasso()
    local tool = FindLassoTool()
    if not tool then
        return false, "Lasso tool not found"
    end

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false, "Humanoid not found"
    end

    if tool.Parent ~= char then
        pcall(function() humanoid:EquipTool(tool) end)
        task.wait(0.08)
    end

    -- Simulate the same primary mouse/tap action a player would use.
    -- This is input simulation, not a RemoteEvent/RemoteFunction call.
    local vim = game:GetService("VirtualInputManager")
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
    local x = math.floor(viewport.X * 0.5)
    local y = math.floor(viewport.Y * 0.5)

    local inputWorked = false
    pcall(function()
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.035)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
        inputWorked = true
    end)

    -- Fallback for environments where VirtualInputManager is unavailable.
    if not inputWorked then
        pcall(function() tool:Activate() end)
    end

    return true
end


--// NOCLIP (from the original tracker behavior)
local NoClipEnabled = false
local NoClipConnection = nil
local NoClipStates = {}

local function SetNoClip(enabled)
    NoClipEnabled = enabled

    if enabled then
        if NoClipConnection then return end

        NoClipConnection = RunService.Stepped:Connect(function()
            if not NoClipEnabled then return end
            local char = LocalPlayer.Character
            if not char then return end

            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") then
                    if NoClipStates[obj] == nil then
                        NoClipStates[obj] = obj.CanCollide
                    end
                    obj.CanCollide = false
                end
            end
        end)
    else
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end

        for part, previousState in pairs(NoClipStates) do
            if part and part.Parent then
                pcall(function() part.CanCollide = previousState end)
            end
        end
        table.clear(NoClipStates)
    end
end


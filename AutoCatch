    ["Paint Horse"]={Rarity="Low"}, ["Paint"]={Rarity="Low"}, ["Morgan"]={Rarity="Low"},
    ["Quarter"]={Rarity="Low"}, ["Quarter Horse"]={Rarity="Low"}, ["Standard Donkey"]={Rarity="Low"},
    ["Donkey"]={Rarity="Low"}, ["Welsh Cob"]={Rarity="Low"},
    ["Connemara"]={Rarity="Mid"}, ["Thoroughbred"]={Rarity="Mid"}, ["Dutch Warmblood"]={Rarity="Mid"},
    ["Akhal-Teke"]={Rarity="Mid"}, ["Icelandic"]={Rarity="Mid"}, ["Andalusian"]={Rarity="Mid"},
    ["Mammoth Donkey"]={Rarity="High"}, ["Percheron"]={Rarity="High"}, ["Friesian"]={Rarity="High"},
    ["Arabian"]={Rarity="High"}, ["Tennessee Walker"]={Rarity="High"}, ["Clydesdale"]={Rarity="High"},

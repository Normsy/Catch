--// ===========================
--// MAIN SCRIPT (`Main.lua`)
--// ===========================

return function(Config)
    Config = Config or {}
    local AutoHopEnabled = Config.AutoHop ~= false
    
    --// CONFIGURE YOUR WEBHOOK HERE
    local WEBHOOK_URL = "https://discord.com/api/webhooks/1392196860026028184/aFSBpdMyZjmg-cLAQsfPd7NEja-9xNUmf-WboOjBcGrmd7GPGK9mPK59UohHPJRDvfb_"

    -- Services
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local StarterGui = game:GetService("StarterGui")
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local Lighting = game:GetService("Lighting")

    local player = Players.LocalPlayer

    -- 1. FPS Cap to 15 & Anti-Lag Boosters
    pcall(function()
        setfpscap(15)
    end)

    -- Optimize Lighting & Rendering for Maximum Performance / Low Lag
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 2
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Sky") then
                v:Destroy()
            end
        end
    end)

    -- Continuous Low-Lag Booster (Clearing particles, textures safely)
    task.spawn(function()
        while true do
            pcall(function()
                for _, v in ipairs(Workspace:GetDescendants()) do
                    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                        v:Destroy()
                    elseif v:IsA("BasePart") and not v:IsDescendantOf(player.Character or workspace) then
                        v.Material = Enum.Material.SmoothPlastic
                        v.CastShadow = false
                    end
                end
            end)
            task.wait(10)
        end
    end)

    -- Rarity Decimal Mapping for Embeds
    local RARITY_DATA = {
        Common = { decimal = 16777215 },
        Uncommon = { decimal = 65280 },
        Rare = { decimal = 255 },
        Epic = { decimal = 8388736 },
        Legendary = { decimal = 16766720 },
        Mythic = { decimal = 16711680 }
    }

    -- Discord Webhook Sender
    local function sendDiscordEmbed(username, petName, rarity, price)
        if WEBHOOK_URL == "" then return end
        pcall(function()
            local info = RARITY_DATA[rarity] or RARITY_DATA["Common"]
            local embedColor = info.decimal
            
            local embed = {
                ["title"] = "⭐ New Pet Caught!",
                ["color"] = embedColor,
                ["fields"] = {
                    {
                        ["name"] = "Username",
                        ["value"] = tostring(username),
                        ["inline"] = true
                    },
                    {
                        ["name"] = "Name",
                        ["value"] = tostring(petName),
                        ["inline"] = true
                    },
                    {
                        ["name"] = "Rarity",
                        ["value"] = tostring(rarity),
                        ["inline"] = true
                    },
                    {
                        ["name"] = "Price",
                        ["value"] = string.format("**🪙 %s**", tostring(price)),
                        ["inline"] = false
                    }
                },
                ["footer"] = {
                    ["text"] = "Clark Pet Catcher"
                }
            }

            local data = {
                ["embeds"] = { embed }
            }
            
            local body = HttpService:JSONEncode(data)
            request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body
            })
        end)
    end

    -- Function to show notification
    local function showNotification(petName, rarity, price)
        local message = string.format("%s %s\nfor 🪙 %s", tostring(rarity), tostring(petName), tostring(price))
        
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Pet Caught!",
                Text = message,
                Duration = 5,
            })
        end)
    end

    -- Server Hopping Function
    local function serverHop()
        if not AutoHopEnabled then return end
        pcall(function()
            local servers = {}
            local req = request({
                Url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", game.PlaceId),
                Method = "GET"
            })
            
            if req and req.Body then
                local decoded = HttpService:JSONDecode(req.Body)
                if decoded and decoded.data then
                    for _, s in ipairs(decoded.data) do
                        if type(s) == "table" and s.maxPlayers and s.playing and s.playing < s.maxPlayers and s.id ~= game.JobId then
                            table.insert(servers, s.id)
                        end
                    end
                end
            end
            
            if #servers > 0 then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
            else
                TeleportService:Teleport(game.PlaceId, player)
            end
        end)
    end

    -- Main Automation Loop
    task.spawn(function()
        local emptyTimeStart = nil
        local notifiedPets = {} -- Tracks pets that have already sent notifications/webhooks

        while true do
            task.wait(0.2)
            
            local character = player.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then
                continue
            end
            local humanoidRootPart = character.HumanoidRootPart

            local map = Workspace:FindFirstChild("Map")
            if not map then continue end
            
            local wildPetSpawns = map:FindFirstChild("WildPetSpawns")
            local wildPetRef = map:FindFirstChild("WildPetRef")
            if not wildPetSpawns or not wildPetRef then continue end

            local spawns = wildPetSpawns:GetChildren()
            
            -- Check if no more pets are found in the spawner
            if #spawns == 0 then
                if not emptyTimeStart then
                    emptyTimeStart = tick()
                elseif tick() - emptyTimeStart >= 5 then
                    if AutoHopEnabled then
                        serverHop()
                        break
                    end
                end
                continue
            else
                emptyTimeStart = nil
            end

            for _, spawnModel in ipairs(spawns) do
                local spawnName = spawnModel.Name
                local uuid = spawnName:match("WildPet_[^_]+_WildPet_(.+)") or spawnName:match("_(%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x)") or spawnName
                local petRef = wildPetRef:FindFirstChild("WildPet_" .. uuid) or wildPetRef:FindFirstChild(uuid)

                if petRef then
                    local ownerUserId = petRef:GetAttribute("OwnerUserId")
                    if ownerUserId and ownerUserId ~= 0 and ownerUserId ~= player.UserId then
                        continue
                    end

                    local rootPart = spawnModel:FindFirstChild("RootPart") or spawnModel.PrimaryPart or spawnModel:FindFirstChildWhichIsA("BasePart")

                    local attempts = 0
                    while spawnModel.Parent and attempts < 30 do
                        attempts = attempts + 1
                        local currentOwner = petRef:GetAttribute("OwnerUserId")
                        
                        if currentOwner == player.UserId then
                            -- Only trigger if this specific pet UUID hasn't been logged yet
                            if not notifiedPets[uuid] then
                                notifiedPets[uuid] = true
                                local petName = petRef:GetAttribute("PetName") or "Unknown"
                                local rarity = petRef:GetAttribute("Rarity") or "Common"
                                local price = petRef:GetAttribute("Price") or "0"

                                showNotification(petName, rarity, price)
                                sendDiscordEmbed(player.Name, petName, rarity, price)
                            end
                            break
                        end

                        if rootPart then
                            humanoidRootPart.CFrame = rootPart.CFrame + Vector3.new(0, 3, 0)
                        end

                        pcall(function()
                            local promptTarget = rootPart or spawnModel
                            local nearestPrompt = promptTarget:FindFirstChild("BuyPrompt", true) or spawnModel:FindFirstChildWhichIsA("ProximityPrompt", true)

                            if nearestPrompt and nearestPrompt:IsA("ProximityPrompt") then
                                nearestPrompt.HoldDuration = 0
                                fireproximityprompt(nearestPrompt)
                            end
                        end)

                        task.wait(0.1)
                        
                        if not spawnModel.Parent or not petRef.Parent then
                            break
                        end
                    end
                end
            end
        end
    end)
end
